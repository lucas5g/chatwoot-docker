@@ -43,6 +44,74 @@ class SafeFetch::Fetcher
     response
   end
 
+  def ssrf_filter_request
+    proc { |&block| SsrfFilter.public_send(options.method, options.url, **options.request_options, &block) }
+  end
+
+  def private_ip_request
+    proc do |&block|
+      http = Net::HTTP.new(resolved_ip_addresses.first, options.uri.port)
+      http.use_ssl = options.uri.scheme == 'https'
+      http.open_timeout = options.open_timeout
+      http.read_timeout = options.read_timeout
+      http.request(net_http_request, &block)
+    end
+  end
+
+  def net_http_request
+    request = net_http_request_class.new(options.uri)
+    request['Host'] ||= host_header
+    options.headers&.each { |key, value| request[key] = value }
+    request.body = options.body if options.body.present?
+
+    credentials = options.http_basic_authentication.presence || uri_basic_authentication(options.uri)
+    request.basic_auth(*credentials) if credentials.present?
+    request
+  end
+
+  def net_http_request_class
+    {
+      delete: Net::HTTP::Delete,
+      get: Net::HTTP::Get,
+      head: Net::HTTP::Head,
+      patch: Net::HTTP::Patch,
+      post: Net::HTTP::Post,
+      put: Net::HTTP::Put
+    }.fetch(options.method)
+  end
+
+  def host_header
+    return options.uri.host if options.uri.port == options.uri.default_port
+
+    "#{options.uri.host}:#{options.uri.port}"
+  end
+
+  def allowed_private_ip_url?
+    return false if options.allow_private_ip_ranges.blank?
+
+    resolved_ip_addresses.present? && resolved_ip_addresses.all? do |address|
+      options.allow_private_ip_ranges.any? { |range| range.include?(IPAddr.new(address)) }
+    end
+  end
+
+  def resolved_ip_addresses
+    @resolved_ip_addresses ||= begin
+      IPAddr.new(options.uri.hostname)
+      [options.uri.hostname]
+    rescue IPAddr::InvalidAddressError
+      Resolv.getaddresses(options.uri.hostname)
+    end
+  end
+
+  def uri_basic_authentication(value)
+    return if value.user.blank?
+
+    [
+      URI.decode_uri_component(value.user),
+      URI.decode_uri_component(value.password.to_s)
+    ]
+  end
+
   def validate_content_type!(content_type)
     return unless options.validate_content_type?
     return if allowed_content_type?(content_type)
